{
  "connector_id": "municipal-project-loop",
  "display_name": "市政项目管理",
  "connector_version": "0.1",
  "project_mode": "single_project",
  "identity": {
    "provider": "dingtalk",
    "binding": "enterprise_sso",
    "user_key": "dingtalk_user_id",
    "project_scope_from_server": true,
    "real_name_required": true,
    "enterprise_member_required": true,
    "project_roster_required": true
  },
  "entrypoints": [
    "我的任务",
    "提交岗位成果",
    "提交施工日志",
    "拍照上传证据",
    "查看待补证据",
    "查看审核状态",
    "生成周报",
    "生成月报",
    "查看造价待验证",
    "提交造价验证"
  ],
  "tools": [
    {"name": "get_user_context", "method": "GET", "path": "/api/connector/user-context", "safety": "read"},
    {"name": "list_my_tasks", "method": "GET", "path": "/api/state", "safety": "read"},
    {"name": "submit_work_record", "method": "POST", "path": "/api/records", "safety": "write_own_scope"},
    {"name": "upload_evidence", "method": "POST", "path": "/api/records", "safety": "write_own_scope"},
    {"name": "compare_periods", "method": "GET", "path": "/api/report", "safety": "read"},
    {"name": "submit_line_review", "method": "POST", "path": "/api/reviews", "safety": "write_line_scope"},
    {"name": "submit_cost_validation", "method": "POST", "path": "/api/cost-validation", "safety": "write_cost_scope"}
  ],
  "security": {
    "project_id_is_server_bound": true,
    "role_is_server_bound": true,
    "ai_cannot_approve_cost": true,
    "public_network_upload": false,
    "per_user_connector_configuration": false
  },
  "runtime_note": "本清单是本工具内部连接器契约，正式部署时由项目后台适配千问平台的实际连接器协议。"
}
