# 复制到项目服务器的安全配置中，再由部署人员填写。
# 不要把真实值提交到 GitHub、聊天记录或项目数据目录。

MUNICIPAL_LOOP_MODE=dingtalk
# 正式部署建议由反向代理接收 HTTPS；应用只监听项目私有网卡或回环地址。
MUNICIPAL_LOOP_HOST=127.0.0.1
MUNICIPAL_LOOP_PORT=8765

# 钉钉企业内部应用
DINGTALK_CORP_ID=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_REDIRECT_URI=https://your-private-domain.example.com/auth/dingtalk/callback
DINGTALK_REQUIRE_REAL_NAME=true
# 仅当可信反向代理已完成钉钉验签并把用户 ID 注入请求时才开启；通常保持 false。
MUNICIPAL_LOOP_TRUSTED_PROXY=false

# 千问企业组织/连接器
QWENWORK_ORG_ID=
QWEN_PROJECT_CONNECTOR_ID=municipal-project-loop

# 单项目固定编号
PROJECT_ID=

# 生产环境必须使用 HTTPS 和企业私有访问域名
PUBLIC_BASE_URL=https://your-private-domain.example.com
